  "author": "arbase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rabin0404/pg-mcp-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Rabin0404/pg-mcp-bridge/issues"
  },
  "homepage": "https://github.com/Rabin0404/pg-mcp-bridge#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  }
}
