{
  "name": "pg-mcp-bridge",
  "version": "1.0.0",
  "description": "Cursor MCP stdio bridge for a remote PHP PostgreSQL tunnel (Navicat-style)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "pg-mcp-bridge": "./dist/index.js"
  },
